# 📌 client/src/App.jsx
```jsx
import { useState } from 'react';

export default function App() {
  const [token, setToken] = useState(localStorage.getItem('wik_token') || '');
  const [username, setUsername] = useState('');
  const [passcode, setPasscode] = useState('');
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState('');

  async function login() {
    const res = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, passcode })
    });
    const j = await res.json();
    if (j.ok) {
      setToken(j.token);
      localStorage.setItem('wik_token', j.token);
    } else alert('Invalid');
  }

  async function send() {
    if (!input.trim()) return;
    const userMsg = { role: 'user', content: input };
    const newMsgs = [...messages, userMsg];
    setMessages(newMsgs);
    setInput('');

    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({ messages: newMsgs })
    });
    const j = await res.json();
    if (j.ok) setMessages([...newMsgs, j.assistant]);
  }

  if (!token) return (
    <div style={{ padding: 40 }}>
      <h2>WIK AI Login</h2>
      <input placeholder="Username" onChange={e=>setUsername(e.target.value)} />
      <br/>
      <input placeholder="Passcode" type="password" onChange={e=>setPasscode(e.target.value)} />
      <br/>
      <button onClick={login}>Login</button>
    </div>
  );

  return (
    <div style={{ padding: 40 }}>
      <h2>WIK AI Chat</h2>
      <div style={{ height: '300px', overflowY: 'auto', border: '1px solid #ccc', padding: 10 }}>
        {messages.map((m, i) => (
          <div key={i} style={{ margin: '8px 0' }}>
            <b>{m.role}:</b> {m.content}
          </div>
        ))}
      </div>
      <input value={input} onChange={e=>setInput(e.target.value)} />
      <button onClick={send}>Send</button>
    </div>
  );
}
```

