# WIK AI — Combined Full-Stack Project (Option A)

Below is the complete **single unified project**, where Express (backend) serves the built React frontend.

Your final project structure:

```
wik-ai/
 ├─ server/
 │   ├─ index.js
 │   ├─ package.json
 │   └─ .env.example
 ├─ client/
 │   ├─ package.json
 │   ├─ vite.config.js
 │   ├─ index.html
 │   └─ src/
 │       ├─ main.jsx
 │       ├─ App.jsx
 │       └─ index.css
 └─ README.md
```

---

# 📌 server/index.js
```js
const express = require('express');
const fetch = require('node-fetch');
const cors = require('cors');
const path = require('path');
const crypto = require('crypto');
require('dotenv').config();

const app = express();
app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 4000;
const USERNAME = 'GEORGE';
const PASSCODE = 'WILLIAM';

// session store
const sessions = new Map();

// login
app.post('/api/login', (req, res) => {
  const { username, passcode } = req.body;
  if (username === USERNAME && passcode === PASSCODE) {
    const token = crypto.randomBytes(24).toString('hex');
    sessions.set(token, { username });
    return res.json({ ok: true, token });
  }
  return res.status(401).json({ ok: false, error: 'Invalid credentials' });
});

// chat
app.post('/api/chat', async (req, res) => {
  const auth = req.headers.authorization || '';
  const token = auth.replace('Bearer ', '');
  if (!sessions.has(token)) return res.status(401).json({ ok: false, error: 'Unauthorized' });

  try {
    const resp = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`
      },
      body: JSON.stringify({
        model: 'gpt-4o-mini',
        messages: req.body.messages
      })
    });

    const data = await resp.json();
    const assistant = data.choices?.[0]?.message || { role: 'assistant', content: 'No response' };
    return res.json({ ok: true, assistant });
  } catch (err) {
    return res.status(500).json({ ok: false, error: err.message });
  }
});

// serve frontend build
app.use(express.static(path.join(__dirname, '../client/dist')));

// fallback to index.html
app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, '../client/dist/index.html'));
});

app.listen(PORT, () => console.log(`WIK AI running on port ${PORT}`));
```

